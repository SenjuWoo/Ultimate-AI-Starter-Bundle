# Shared with the default Hermes home. Do not commit a filled-in copy.
# The installer hard-links profiles/sillytavern/.env to the home .env so the
# API server key, OpenRouter key, and port stay in one file.

# SillyTavern connects to this OpenAI-compatible endpoint.
# URL: http://127.0.0.1:8642/v1
# Model name below is what SillyTavern sends. Hermes then calls LM Studio.
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_MODEL_NAME=hermes-rp
# API_SERVER_KEY=  set a long random local key. SillyTavern sends it as the API key.

# Image analysis uses the OpenRouter vision model in config.yaml when this is set.
# OPENROUTER_API_KEY=

# Image generation uses whatever Hermes image backend you already configured.
# FAL_KEY=
