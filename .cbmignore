# Generated provider skill copies are byte-identical to _CANONICAL-SKILLS
# except the provider tag. Index the canonical tree only.

1-TAILORED-PROVIDER-TREES/*/COPY-TO-SKILLS-DIRECTORY/skills/

artifacts/
dist/
__pycache__/
BUNDLED-TOOLS/cache/
