 "schema": 1,
 "note": "Optional companion owners. The bundle detects, plans and delegates; each owner installs, updates and heals itself. Nothing here is executed without an explicit --run on an allowlisted entrypoint. A directory only counts when its name matches the owner's repository name, so a backup or an unrelated tool that happens to contain the same marker file cannot be mistaken for that companion.",
 "owner_allowlist": [
  "github.com/SenjuWoo/"
 ],
 "companions": {
  "roblox-forge": {
   "title": "RobloxForge",
   "repo": "https://github.com/SenjuWoo/RobloxForge",
   "install": {
    "kind": "release_zip",
    "asset": "RobloxForge-*.zip",
    "entrypoint": "Install.ps1"
   },
   "update": {
    "entrypoint": "Update.ps1"
   },
   "doctor": {
    "entrypoint": [
     "python",
     "src/rbforge_cli.py",
     "doctor"
    ]
   },
   "markers": [
    "src/rbforge/__init__.py"
   ],
   "capabilities": {
    "cli": "rbforge",
    "mcp": "robloxforge",
    "skills": "owned by RobloxForge: 2 first-party + 23 adopted; query `rbforge skills status`",
    "gui": false
   },
   "requires": [],
   "platforms": [
    "windows",
    "linux",
    "macos"
   ],
   "notes": "Owns the Roblox skill catalog and knowledge/vendor; the bundle never copies it. Studio work needs the separate official Roblox Studio MCP."
  },
